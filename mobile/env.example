# Copy this file to an uncommitted mobile/.env file for local development.
# Then restart Expo: npx expo start

# Backend API (voice chat, analyze, open banking)
# Same machine: http://localhost:8001
# Android emulator: http://10.0.2.2:8001
# Physical device on the same Wi-Fi: http://YOUR_PC_IP:8001
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Voice chat uses Groq via the backend. Configure GROQ_API_KEY as a backend deployment secret.
# Do not put server-side provider secrets in the mobile app.

# Supabase (Project Settings → API). Never commit real keys to git.
# No quotes or semicolons at the end of values.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Phone signup requires Phone auth enabled in Supabase (Authentication → Providers → Phone)
# with an SMS provider such as Twilio configured.

# SMS ingestion source:
# - device = real Android inbox (production)
# - demo   = remote transaction dataset JSON (no inbox access; for pitches)
EXPO_PUBLIC_SMS_SOURCE=demo

# Required when SMS_SOURCE=demo. Public JSON with a "transactions" array.
# Example shape: { "transactions": [{ "transaction_id", "date", "amount", "direction", "bank", "merchant", "category", "description", "user_id" }] }
EXPO_PUBLIC_DEMO_SMS_URL=https://example.com/tracepay_dataset.json
