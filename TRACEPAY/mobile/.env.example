# Node auth API (TRACEPAY/backend). localhost is rewritten to the Expo machine
# (LAN IP on a physical phone, 10.0.2.2 on an Android emulator).
EXPO_PUBLIC_API_URL=http://localhost:4001

# Public Supabase URL/anon key are only for client session storage after login.
# Auth (register, login, Twilio SMS) runs on TRACEPAY/backend — never put Twilio secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
