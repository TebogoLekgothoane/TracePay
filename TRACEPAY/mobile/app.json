{
  "expo": {
    "name": "TRACEPAY",
    "slug": "tracepay",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tracepay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tracepay.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow TracePay to use Face ID to unlock the app."
      }
    },
    "android": {
      "package": "com.tracepay.mobile",
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-sqlite",
      "./plugins/withTracePayAndroidIngestion",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow TracePay to use Face ID to unlock the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9FE",
          "dark": {
            "backgroundColor": "#090B14"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
