{
  "expo": {
    "name": "TRACEPAY",
    "slug": "tracepay",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tracepay",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tracepay.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow TracePay to use Face ID to unlock the app.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tracepay.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#0E0B1D"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow TracePay to use Face ID to unlock the app."
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "./plugins/withTracePayAndroidIngestion",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow TracePay to use Face ID to unlock the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9FE",
          "dark": {
            "backgroundColor": "#050505"
          }
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "872cf9c9-a9e6-45c5-a426-bcb00f70468c"
      }
    }
  }
}
