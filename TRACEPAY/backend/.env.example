# Shared Supabase project
SUPABASE_URL=
# Publishable/anon key only. Never paste the service-role JWT here.
SUPABASE_ANON_KEY=
# Optional alias for SUPABASE_ANON_KEY (Python). Ignored if it is a service-role key.
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated HMAC secret for password-reset tokens (min 32 chars). Never reuse the service-role key.
AUTH_RESET_TOKEN_SECRET=

# AI categorisation providers. Never commit keys.
# Order when AI_CATEGORISATION_ENABLED=true: OpenRouter → OpenAI → optional Grok (xAI).
# Gemini remains separately configurable only for optional PDF extraction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=TracePay

# Optional LLM labels for subscription detection, via OpenRouter. Off by default.
# Only names unknown merchant strings and writes a short reason; never sets
# amounts, dates, cadence or payment classes. Sends normalised merchant strings,
# amounts, dates and counts only. Requires a pinned model ID to turn on.
SUBSCRIPTION_LLM_ENABLED=false
SUBSCRIPTION_LLM_MODEL=
SUBSCRIPTION_LLM_TIMEOUT_SECONDS=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120

# Optional Grok via xAI (https://console.x.ai). Do not put Google AI Studio keys here.
# GROK_API_KEY is accepted as an alias for XAI_API_KEY.
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=120

# Optional Anthropic key (currently unused by the app). Statement PDFs are never sent to any
# AI provider. Never commit keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_SECONDS=45

# Enable AI only for transactions that deterministic rules + merchant memory cannot classify.
# Categorisation never receives the statement PDF.
AI_CATEGORISATION_ENABLED=false

# Shared merchant directory: reuse merchant answers any user already taught the app, so each
# unfamiliar description is only sent to AI once. Stores description text, merchant and category
# only. Needs SUPABASE_SERVICE_ROLE_KEY and the merchant_directory migration.
MERCHANT_DIRECTORY_ENABLED=false

# Superadmin beta dashboard at /superadmin (server-side only). Use a random string of 32+
# characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Leave empty to disable the dashboard data endpoint.
SUPERADMIN_DASHBOARD_TOKEN=
# Optional. Per-model prices (USD per million tokens, [input, output]) for the dashboard's AI cost
# estimate. Built-in defaults cover the default models; set this to correct or extend them.
# AI_MODEL_PRICES_JSON={"openai/gpt-4o-mini": [0.15, 0.6]}

# BulkSMS (v2 API). Create an API token in the BulkSMS dashboard.
# Never put these in TRACEPAY/mobile.
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
# Optional alphanumeric sender ID (e.g. TRACEPAY). Must be allowed on your BulkSMS account.
BULKSMS_SENDER_ID=
# Optional. Set to production on deploy hosts that do not set NODE_ENV.
# AUTH_ENV=production

# Dev-only synthetic intelligence runner. Both must be set, and TRACEPAY_ENV must
# be development. Leave the flag false in every deployed environment.
# TRACEPAY_ENV=development
# SYNTHETIC_INTELLIGENCE_DEBUG=false

# Billing. Server-side only. Never put these in TRACEPAY/mobile.
# SUPABASE_SERVICE_ROLE_KEY (above) writes purchase rows, and only after RevenueCat confirms.
# Prices in cents (ZAR), recorded on purchases. Keep them equal to the store prices.
FULL_ANALYSIS_PRICE_CENTS=4900
# Annual monitoring: R299 per year.
MONITORING_PRICE_CENTS=29900

# Billing (RevenueCat in-app purchases). Server-side only.
# v1 secret REST API key from RevenueCat > Project settings > API keys.
REVENUECAT_SECRET_KEY=
# Value of the Authorization header set on the RevenueCat webhook
# (POST /billing/webhooks/revenuecat).
REVENUECAT_WEBHOOK_SECRET=
# Store product ids: a non-consumable and an annual auto-renewing subscription.
REVENUECAT_FULL_ANALYSIS_PRODUCT_ID=tracepay_full_analysis
REVENUECAT_MONITORING_PRODUCT_ID=tracepay_annual_monitoring
