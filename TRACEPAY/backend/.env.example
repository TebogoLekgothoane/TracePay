# Shared Supabase project
SUPABASE_URL=
# Publishable/anon key only. Never paste the service-role JWT here — Node startup rejects it.
SUPABASE_ANON_KEY=
# Optional alias for SUPABASE_ANON_KEY (Python). Ignored if it is a service-role key.
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Node auth API (npm run dev in TRACEPAY/backend)
AUTH_PORT=4001
# Comma-separated browser origins. Native apps do not send Origin and are always allowed.
# Leave empty in production unless you also run the Expo web client.
AUTH_CORS_ORIGINS=
# Dedicated HMAC secret for password-reset tokens (min 32 chars). Never reuse the service-role key.
AUTH_RESET_TOKEN_SECRET=

# AI categorisation providers. Never commit keys.
# Order when AI_CATEGORISATION_ENABLED=true: OpenRouter → OpenAI → optional Grok (xAI).
# Gemini remains separately configurable only for optional PDF extraction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=TracePay

# Google AI Studio keys go in GEMINI_API_KEY (they usually start with AQ.).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120

# Optional Grok via xAI (https://console.x.ai). Do not put Google AI Studio keys here.
# GROK_API_KEY is accepted as an alias for XAI_API_KEY.
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=120

# Optional Anthropic for PDF AI extraction only. Never commit keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_SECONDS=45

# Enable AI only for transactions that deterministic rules + merchant memory cannot classify.
# Independent of AI_PDF_EXTRACTION_ENABLED. Categorisation never receives the statement PDF.
AI_CATEGORISATION_ENABLED=false

# Enables AI-assisted extraction of bank statement PDFs when classical extraction and OCR
# cannot produce a usable result. Disabled by default because the PDF may contain
# sensitive financial information. Independent of AI_CATEGORISATION_ENABLED.
AI_PDF_EXTRACTION_ENABLED=false

# Twilio — copy from the old TracePay Supabase Phone provider / Twilio console.
# Never put these in TRACEPAY/mobile.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Required in production. Prefer this everywhere — OTP codes stay in Twilio Verify.
TWILIO_VERIFY_SERVICE_SID=
# Dev-only SMS sender when Verify SID is unset. Ignored when Verify SID is set.
TWILIO_FROM=
# Dev-only. Allows in-process OTP when TWILIO_VERIFY_SERVICE_SID is unset.
# Must be exactly true/1/yes/on. Rejected when NODE_ENV/AUTH_ENV (or host) is production.
AUTH_ALLOW_OTP_FALLBACK=false
# Optional. Set to production on deploy hosts that do not set NODE_ENV.
# AUTH_ENV=production

# Dev-only synthetic intelligence runner. Both must be set, and TRACEPAY_ENV must
# be development. Leave the flag false in every deployed environment.
# TRACEPAY_ENV=development
# SYNTHETIC_INTELLIGENCE_DEBUG=false
