# Python financial API
SUPABASE_URL=
SUPABASE_KEY=

# Node auth API (npm run dev in TRACEPAY/backend)
AUTH_PORT=4001
SUPABASE_ANON_KEY=

# Optional batched Gemini fallback for unknown transactions. Never commit the key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SUPABASE_SERVICE_ROLE_KEY=

# Twilio — copy from the old TracePay Supabase Phone provider / Twilio console.
# Never put these in TRACEPAY/mobile.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of these is required to send the OTP SMS:
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM=
